{
    "name": "create-vg-stub",
    "version": "0.4.0",
    "description": "Quickly create a video game stub on the Chinese Wikipedia.",
    "private": true,
    "license": "CC BY-SA 4.0",
    "author": "For Each ... Next",
    "type": "module",
    "main": "./src/index.js",
    "browser": "./src/index.js",
    "gadgetBuild": {
        "globalName": "createVgStub",
        "outputName": "create_vg_stub",
        "defines": {
            "__CREATE_VG_STUB_FIELD_DATA__": {
                "jsonDirectories": [
                    "src/terminologies",
                    "src/sources",
                    "src/wikitext"
                ]
            }
        },
        "userscript": {
            "match": [
                "https://en.wikipedia.org/*",
                "https://zh.wikipedia.org/*"
            ]
        }
    },
    "files": [
        "dist",
        "README.md",
        "src"
    ],
    "keywords": [
        "mediawiki",
        "gadget",
        "wikipedia",
        "zhwiki",
        "video-games"
    ],
    "scripts": {
        "build": "node ../../scripts/build-gadget.mjs",
        "check": "npm run lint && node --check src/index.js",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "test": "node --import ./tests/setup.mjs --test",
        "prepublishOnly": "npm run check"
    },
    "engines": {
        "node": ">=20"
    }
}
