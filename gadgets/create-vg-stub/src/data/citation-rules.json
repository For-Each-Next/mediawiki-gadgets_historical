[
  {
    "fixes": [
      {
        "action": "replace",
        "field": "language",
        "operand": {
          "pattern": "^(?!zh(?:-|$))([a-z]+)-.+$",
          "replacement": "$1"
        }
      }
    ]
  },
  {
    "host": "gnn.gamer.com.tw",
    "fixes": [
      {
        "action": "omit",
        "field": "author",
        "operand": "巴哈姆特"
      }
    ]
  },
  {
    "host": "opencritic.com",
    "fixes": [
      {
        "action": "omit",
        "field": "date"
      }
    ]
  },
  {
    "host": "www.metacritic.com",
    "fixes": [
      {
        "action": "set",
        "field": "website",
        "operand": "Metacritic"
      },
      {
        "action": "replace",
        "field": "title",
        "operand": {
          "pattern": " - Metacritic$",
          "replacement": ""
        }
      }
    ]
  },
  {
    "host": "store.steampowered.com",
    "fixes": [
      {
        "action": "set",
        "field": "website",
        "operand": "Steam"
      },
      {
        "action": "set-from-source-query",
        "field": "language",
        "operand": {
          "key": "l",
          "values": {
            "schinese": "zh-Hans",
            "tchinese": "zh-Hant"
          }
        }
      },
      {
        "action": "preserve-source-query",
        "field": "url",
        "operand": ["l"]
      }
    ]
  }
]
