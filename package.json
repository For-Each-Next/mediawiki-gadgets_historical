{
    "name": "mediawiki-gadgets",
    "version": "0.1.0",
    "private": true,
    "description": "JavaScript development workspace for MediaWiki gadgets.",
    "type": "module",
    "workspaces": [
        "gadgets/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "check": "npm run lint && npm run format:check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "esbuild": "^0.28.0",
        "eslint": "^9.0.0",
        "eslint-plugin-jsdoc": "^50.0.0",
        "jsonc-eslint-parser": "^3.1.0",
        "prettier": "^3.0.0",
        "terser": "^5.48.0"
    },
    "engines": {
        "node": ">=20"
    }
}
