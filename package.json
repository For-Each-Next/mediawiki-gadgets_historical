{
    "name": "mediawiki-gadgets",
    "version": "0.1.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "description": "TypeScript development workspace for MediaWiki gadgets.",
    "type": "module",
    "workspaces": [
        "src/*"
    ],
    "scripts": {
        "build": "node scripts/gadget-build/workspace-cli.ts",
        "build:all-userscript": "node scripts/gadget-build/all-cli.ts",
        "build:packages": "npm run build --workspaces --if-present",
        "build:verify": "node scripts/gadget-build/verify-cli.ts",
        "check": "npm run check:repository && npm run typecheck && npm run lint && npm test && npm run format:check",
        "check:layers": "node scripts/check-layer-dependencies.ts",
        "check:markdown": "node scripts/check-markdown-lines.ts",
        "check:packages": "node scripts/check-gadget-packages.ts",
        "check:repository": "node scripts/repository-check/cli.ts",
        "format": "prettier --write \"*.md\" package.json \"tsconfig*.json\" \"*.config.ts\" .github config docs src scripts tests",
        "format:check": "prettier --check \"*.md\" package.json \"tsconfig*.json\" \"*.config.ts\" .github config docs src scripts tests",
        "lint": "eslint config src scripts tests && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:fix": "eslint config src scripts tests --fix",
        "test": "npm run test:repository && npm run test --workspaces --if-present",
        "test:repository": "node --test tests/repository/contracts/*.test.ts tests/repository/build/*.test.ts",
        "typecheck": "npm run typecheck:browser && npm run typecheck:node",
        "typecheck:browser": "vue-tsc --build tsconfig.json",
        "typecheck:node": "tsc --noEmit -p config/tsconfig.node.json",
        "verify": "npm run check && npm run build:verify"
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended"
        ],
        "rules": {
            "declaration-property-value-keyword-no-deprecated": null,
            "no-descending-specificity": null
        }
    },
    "prettier": {
        "printWidth": 79,
        "proseWrap": "always",
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "quoteProps": "preserve",
        "trailingComma": "all",
        "bracketSpacing": true,
        "arrowParens": "always",
        "endOfLine": "lf"
    },
    "devDependencies": {
        "@types/html-minifier-terser": "^7.0.2",
        "@types/node": "^24.13.3",
        "@typescript-eslint/parser": "^8.64.0",
        "@vue/compiler-sfc": "^3.5.13",
        "@wikimedia/codex-design-tokens": "^2.6.2",
        "esbuild": "^0.28.0",
        "eslint": "^9.0.0",
        "html-minifier-terser": "^7.2.0",
        "jiti": "^2.7.0",
        "postcss": "^8.5.19",
        "postcss-selector-parser": "^7.1.4",
        "prettier": "^3.0.0",
        "stylelint": "^17.14.0",
        "stylelint-config-recommended": "^18.0.0",
        "terser": "^5.48.0",
        "types-mediawiki": "^2.1.0",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.8"
    },
    "engines": {
        "node": ">=24.14.1"
    }
}
