{
    "name": "mediawiki-gadgets",
    "version": "0.1.0",
    "private": true,
    "description": "TypeScript development workspace for MediaWiki gadgets.",
    "type": "module",
    "imports": {
        "#shared": "./src/shared/index.ts",
        "#stub/app/*": "./src/vg-stub-creator/application/*",
        "#stub/article": "./src/vg-stub-creator/domain/article/processor.ts",
        "#stub/editing/*": "./src/vg-stub-creator/infrastructure/editing/*",
        "#stub/form/*": "./src/vg-stub-creator/presentation/form/*",
        "#stub/handlers/*": "./src/vg-stub-creator/infrastructure/handlers/*",
        "#stub/terms": "./src/vg-stub-creator/config/terminologies/index.ts",
        "#stub/ui/*": "./src/vg-stub-creator/presentation/*"
    },
    "workspaces": [
        "src/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "architecture:check": "node scripts/check-architecture.ts",
        "check": "npm run architecture:check && npm run i18n:check && npm run typecheck && npm run lint && npm test && npm run source:check && npm run format:check",
        "format": "prettier --write src scripts tests",
        "format:check": "prettier --check src scripts tests",
        "i18n:check": "node scripts/check-i18n.ts",
        "lint": "eslint src scripts tests",
        "lint:fix": "eslint src scripts tests --fix",
        "source:check": "node scripts/check-source-style.ts",
        "test": "npm run test --workspaces --if-present",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@typescript-eslint/parser": "^8.64.0",
        "esbuild": "^0.28.0",
        "eslint": "^9.0.0",
        "eslint-plugin-jsdoc": "^50.0.0",
        "jiti": "^2.7.0",
        "prettier": "^3.0.0",
        "terser": "^5.48.0",
        "types-mediawiki": "^2.1.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22.18"
    }
}
