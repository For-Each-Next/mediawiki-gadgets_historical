{
    "name": "mediawiki-gadgets",
    "version": "0.1.0",
    "private": true,
    "description": "TypeScript development workspace for MediaWiki gadgets.",
    "type": "module",
    "imports": {
        "#shared": "./src/shared/index.ts"
    },
    "workspaces": [
        "src/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "check": "npm run typecheck && npm run lint && npm test && npm run format:check",
        "format": "prettier --write src scripts tests",
        "format:check": "prettier --check src scripts tests",
        "lint": "eslint src scripts tests && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:fix": "eslint src scripts tests --fix",
        "test": "npm run test --workspaces --if-present",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@typescript-eslint/parser": "^8.64.0",
        "esbuild": "^0.28.0",
        "eslint": "^9.0.0",
        "jiti": "^2.7.0",
        "prettier": "^3.0.0",
        "stylelint": "^17.14.0",
        "stylelint-config-recommended": "^18.0.0",
        "terser": "^5.48.0",
        "types-mediawiki": "^2.1.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22.18"
    }
}
