{
    "name": "mediawiki-gadgets",
    "version": "0.1.0",
    "private": true,
    "description": "TypeScript development workspace for MediaWiki gadgets.",
    "type": "module",
    "imports": {
        "#shared": "./src/shared/index.ts",
        "#shared/citoid": "./src/shared/citoid.ts",
        "#shared/edit-box": "./src/shared/edit-box.ts",
        "#shared/html": "./src/shared/html.ts",
        "#shared/i18n": "./src/shared/i18n.ts",
        "#shared/wikitext": "./src/shared/wikitext.ts"
    },
    "workspaces": [
        "src/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "check": "npm run check:packages && npm run check:layers && npm run check:markdown && npm run typecheck && npm run lint && npm test && npm run format:check",
        "check:layers": "node scripts/check-layer-dependencies.ts",
        "check:markdown": "node scripts/check-markdown-lines.ts",
        "check:packages": "node scripts/check-gadget-packages.ts",
        "format": "prettier --write \"*.md\" .prettierrc.json package.json tsconfig.json \"*.config.ts\" src scripts tests",
        "format:check": "prettier --check \"*.md\" .prettierrc.json package.json tsconfig.json \"*.config.ts\" src scripts tests",
        "lint": "eslint src scripts tests && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:fix": "eslint src scripts tests --fix",
        "test": "npm run test:repository && npm run test --workspaces --if-present",
        "test:repository": "node --test tests/repository/*.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/html-minifier-terser": "^7.0.2",
        "@types/node": "^26.1.1",
        "@typescript-eslint/parser": "^8.64.0",
        "@vue/compiler-sfc": "^3.5.13",
        "@wikimedia/codex-design-tokens": "^2.6.2",
        "esbuild": "^0.28.0",
        "eslint": "^9.0.0",
        "html-minifier-terser": "^7.2.0",
        "jiti": "^2.7.0",
        "postcss": "^8.5.19",
        "postcss-selector-parser": "^7.1.4",
        "prettier": "^3.0.0",
        "stylelint": "^17.14.0",
        "stylelint-config-recommended": "^18.0.0",
        "terser": "^5.48.0",
        "types-mediawiki": "^2.1.0",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22.18"
    }
}
