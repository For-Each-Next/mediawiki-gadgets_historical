{
    "name": "citation-formatter",
    "version": "0.6.0",
    "description": "Format and manage citations in MediaWiki source editors.",
    "private": true,
    "license": "CC0-1.0",
    "author": "For Each ... Next",
    "type": "module",
    "imports": {
        "#gadget": "./index.ts",
        "#gadget/*": "./*",
        "#shared/*": "@mediawiki-gadgets/shared/*"
    },
    "main": "./index.ts",
    "browser": "./browser.ts",
    "vue": {
        "outputDir": "../../dist",
        "assetsDir": "",
        "filenameHashing": false,
        "css": {
            "extract": false
        }
    },
    "gadgetBuild": {
        "globalName": "citationFormatter",
        "headerDescription": [
            "Formats CS1 and other Cite-prefixed templates, manages sources, and reviews citation issues without leaving the MediaWiki source editor."
        ],
        "noticeFiles": [
            "LICENSE"
        ],
        "outputName": "citation_formatter",
        "defines": {
            "__CITATION_FORMATTER_STYLES__": {
                "textFile": "ui/styles.css"
            },
            "__CITATION_FORMATTER_MAIN_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/main-dialog.vue"
            },
            "__CITATION_FORMATTER_MAIN_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/main-dialog.css"
            },
            "__CITATION_FORMATTER_DRAFT_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/draft-dialog.vue"
            },
            "__CITATION_FORMATTER_DRAFT_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/draft-dialog.css"
            },
            "__CITATION_FORMATTER_PARAMETER_ALIAS_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/parameter-alias-dialog.vue"
            },
            "__CITATION_FORMATTER_PARAMETER_ALIAS_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/parameter-alias-dialog.css"
            },
            "__CITATION_FORMATTER_TOOL_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/tool-dialog.vue"
            },
            "__CITATION_FORMATTER_TOOL_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/tool-dialog.css"
            },
            "__CITATION_FORMATTER_CLOSE_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/close-confirmation-dialog.vue"
            },
            "__CITATION_FORMATTER_CLOSE_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/close-confirmation-dialog.css"
            }
        },
        "userscript": {
            "match": [
                "https://*.wikipedia.org/*",
                "https://*.wikimedia.org/*"
            ]
        }
    },
    "keywords": [
        "citation",
        "mediawiki",
        "wikipedia",
        "wikitext"
    ],
    "scripts": {
        "build": "node ../../scripts/gadget-build/cli.ts",
        "check": "npm run lint && vue-tsc --build ../../config/vue/tsconfig.citation-formatter.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --test ../../tests/citation-formatter/*.test.ts",
        "update:template-data": "node ../../scripts/update-citation-template-data.ts"
    },
    "dependencies": {
        "@mediawiki-gadgets/shared": "*"
    },
    "devDependencies": {
        "@wikimedia/codex": "^2.6.0",
        "@wikimedia/codex-icons": "^2.6.0",
        "vue": "3.5.13"
    },
    "engines": {
        "node": ">=24.14.1"
    }
}
