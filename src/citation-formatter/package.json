{
    "name": "citation-formatter",
    "version": "0.3.4",
    "description": "Format CS1 citations and convert inline citations to list-defined references.",
    "private": true,
    "license": "CC BY-SA 4.0",
    "author": "For Each ... Next",
    "type": "module",
    "imports": {
        "#me": "./index.ts",
        "#me/*": "./*",
        "#shared": "@mediawiki-gadgets/shared"
    },
    "main": "./index.ts",
    "browser": "./index.ts",
    "gadgetBuild": {
        "globalName": "citationFormatter",
        "outputDirectory": "../../dist/citation-formatter",
        "outputName": "citation_formatter",
        "userscript": {
            "match": [
                "https://*.wikipedia.org/*",
                "https://*.wikimedia.org/*"
            ]
        }
    },
    "files": [
        "README.md",
        "*.ts",
        "domain",
        "infra",
        "ui"
    ],
    "keywords": [
        "citation",
        "mediawiki",
        "wikipedia",
        "wikitext"
    ],
    "scripts": {
        "build": "node ../../scripts/build-gadget.ts",
        "check": "npm run lint && tsc --noEmit -p ../../tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --test ../../tests/citation-formatter/*.test.ts",
        "prepublishOnly": "npm run check"
    },
    "engines": {
        "node": ">=22.18"
    }
}
