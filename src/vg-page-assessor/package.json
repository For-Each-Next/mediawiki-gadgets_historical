{
    "name": "vg-page-assessor",
    "version": "0.2.0",
    "description": "Assess Chinese Wikipedia video game talk pages and register pages on the WikiProject new-page list.",
    "private": true,
    "license": "CC BY-SA 4.0",
    "author": "For Each ... Next",
    "type": "module",
    "imports": {
        "#gadget": "./index.ts",
        "#gadget/*": "./*",
        "#shared": "@mediawiki-gadgets/shared",
        "#shared/*": "@mediawiki-gadgets/shared/*"
    },
    "main": "./index.ts",
    "browser": "./browser.ts",
    "gadgetBuild": {
        "globalName": "vgPageAssessor",
        "outputDirectory": "../../dist/vg-page-assessor",
        "outputName": "vg_page_assessor",
        "defines": {
            "__VG_PAGE_ASSESSOR_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/assessment-dialog.vue"
            },
            "__VG_PAGE_ASSESSOR_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/assessment-dialog.css"
            }
        },
        "userscript": {
            "match": [
                "https://zh.wikipedia.org/*"
            ]
        }
    },
    "files": [
        "README.md",
        "AGENTS.md",
        "CHANGELOG.md",
        "*.ts",
        "config",
        "contracts",
        "domain",
        "infra",
        "i18n",
        "ui",
        "workflows"
    ],
    "keywords": [
        "mediawiki",
        "wikipedia",
        "zhwiki",
        "video-games",
        "assessment"
    ],
    "scripts": {
        "build": "node ../../scripts/build-gadget.ts",
        "check": "npm run lint && tsc --noEmit -p ../../tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --test ../../tests/vg-page-assessor/*.test.ts",
        "prepublishOnly": "npm run check"
    },
    "engines": {
        "node": ">=22.18"
    }
}
