{
    "name": "vg-page-assessor",
    "version": "1.0.0-rc.3",
    "description": "Assess Chinese Wikipedia video game talk pages and register pages on the WikiProject new-page list.",
    "private": true,
    "license": "CC BY-SA 4.0",
    "author": "For Each ... Next",
    "type": "module",
    "main": "./index.ts",
    "browser": "./index.ts",
    "gadgetBuild": {
        "globalName": "vgPageAssessor",
        "outputDirectory": "../../dist/vg-page-assessor",
        "outputName": "vg_page_assessor",
        "styleEntryPoint": "styles.css",
        "defines": {
            "__ASSESS_VG_PAGE_DIALOG_CSS__": {
                "textFile": "styles.css"
            }
        },
        "userscript": {
            "match": [
                "https://zh.wikipedia.org/*"
            ]
        }
    },
    "files": [
        "README.md",
        "*.ts",
        "styles.css"
    ],
    "keywords": [
        "mediawiki",
        "wikipedia",
        "zhwiki",
        "video-games",
        "assessment"
    ],
    "scripts": {
        "build": "node ../../scripts/build-gadget.ts",
        "check": "npm run lint && tsc --noEmit -p ../../tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --test ../../tests/vg-page-assessor/*.test.ts",
        "prepublishOnly": "npm run check"
    },
    "engines": {
        "node": ">=22.18"
    }
}
