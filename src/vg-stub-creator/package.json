{
    "name": "vg-stub-creator",
    "version": "0.4.33-post.1",
    "description": "Quickly create a video game stub on the Chinese Wikipedia.",
    "private": true,
    "license": "CC BY-SA 4.0",
    "author": "For Each ... Next",
    "type": "module",
    "imports": {
        "#me": "./index.ts",
        "#me/*": "./*",
        "#shared": "@mediawiki-gadgets/shared"
    },
    "main": "./index.ts",
    "browser": "./index.ts",
    "gadgetBuild": {
        "globalName": "vgStubCreator",
        "outputDirectory": "../../dist/vg-stub-creator",
        "outputName": "vg_stub_creator",
        "styleEntryPoint": "ui/styles.css",
        "defines": {
            "__VG_STUB_CREATOR_DIALOG_CSS__": {
                "textFile": "ui/styles.css"
            }
        },
        "userscript": {
            "name": "VG Stub Creator",
            "match": [
                "https://en.wikipedia.org/*",
                "https://zh.wikipedia.org/*"
            ]
        }
    },
    "files": [
        "README.md",
        "AGENTS.md",
        "HISTORY.md",
        "docs",
        "*.ts",
        "app",
        "domain",
        "infra",
        "i18n",
        "ui",
        "shared",
        "config"
    ],
    "keywords": [
        "mediawiki",
        "gadget",
        "wikipedia",
        "zhwiki",
        "video-games"
    ],
    "scripts": {
        "build": "node ../../scripts/build-gadget.ts",
        "check": "npm run lint && tsc --noEmit -p ../../tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --test ../../tests/vg-stub-creator/*.test.ts",
        "prepublishOnly": "npm run check"
    },
    "engines": {
        "node": ">=22.18"
    },
    "devDependencies": {
        "@wikimedia/codex": "^2.6.0",
        "vue": "3.5.13"
    }
}
