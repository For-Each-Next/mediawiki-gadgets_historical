{
    "name": "vg-stub-creator",
    "version": "0.4.25",
    "description": "Quickly create a video game stub on the Chinese Wikipedia.",
    "private": true,
    "license": "CC BY-SA 4.0",
    "author": "For Each ... Next",
    "type": "module",
    "imports": {
        "#shared": "@mediawiki-gadgets/shared",
        "#stub/app/*": "./application/*",
        "#stub/article": "./domain/article/processor.ts",
        "#stub/config/*": "./config/*",
        "#stub/data": "./domain/data.ts",
        "#stub/editing/*": "./infrastructure/editing/*",
        "#stub/form": "./presentation/form/index.ts",
        "#stub/form/*": "./presentation/form/*",
        "#stub/handlers/*": "./infrastructure/handlers/*",
        "#stub/i18n": "./i18n/index.ts",
        "#stub/i18n/*": "./i18n/*",
        "#stub/local/*": "./shared/*",
        "#stub/main": "./presentation/main/index.ts",
        "#stub/main/*": "./presentation/main/*",
        "#stub/modules": "./domain/modules.ts",
        "#stub/save/*": "./infrastructure/save/*",
        "#stub/sources": "./infrastructure/sources/index.ts",
        "#stub/sources/*": "./infrastructure/sources/*",
        "#stub/terms": "./config/terminologies/index.ts",
        "#stub/terms/*": "./config/terminologies/*",
        "#stub/ui/*": "./presentation/*",
        "#stub/wiki": "./domain/wiki.ts"
    },
    "main": "./index.ts",
    "browser": "./index.ts",
    "gadgetBuild": {
        "globalName": "vgStubCreator",
        "outputDirectory": "../../dist/vg-stub-creator",
        "outputName": "vg_stub_creator",
        "styleEntryPoint": "presentation/styles.css",
        "defines": {
            "__VG_STUB_CREATOR_DIALOG_CSS__": {
                "textFile": "presentation/styles.css"
            }
        },
        "userscript": {
            "name": "VG Stub Creator",
            "match": [
                "https://en.wikipedia.org/*",
                "https://zh.wikipedia.org/*"
            ]
        }
    },
    "files": [
        "README.md",
        "DEVELOPMENT.md",
        "*.ts",
        "application",
        "domain",
        "infrastructure",
        "i18n",
        "presentation",
        "shared",
        "config"
    ],
    "keywords": [
        "mediawiki",
        "gadget",
        "wikipedia",
        "zhwiki",
        "video-games"
    ],
    "scripts": {
        "build": "node ../../scripts/build-gadget.ts",
        "check": "npm run lint && tsc --noEmit -p ../../tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --import ../../tests/vg-stub-creator/setup.ts --test ../../tests/vg-stub-creator/*.test.ts",
        "prepublishOnly": "npm run check"
    },
    "engines": {
        "node": ">=22.18"
    },
    "devDependencies": {
        "@wikimedia/codex": "^2.6.0",
        "vue": "3.5.13"
    }
}
