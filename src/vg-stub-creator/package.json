{
    "name": "vg-stub-creator",
    "version": "0.5.3-post.1",
    "description": "Create and review Chinese Wikipedia video game stubs.",
    "private": true,
    "license": "CC0-1.0",
    "author": "For Each ... Next",
    "type": "module",
    "imports": {
        "#gadget": "./index.ts",
        "#gadget/*": "./*",
        "#shared": "@mediawiki-gadgets/shared",
        "#shared/*": "@mediawiki-gadgets/shared/*"
    },
    "main": "./index.ts",
    "browser": "./browser.ts",
    "vue": {
        "outputDir": "../../dist",
        "assetsDir": "",
        "filenameHashing": false,
        "css": {
            "extract": false
        }
    },
    "gadgetBuild": {
        "globalName": "vgStubCreator",
        "headerDescription": [
            "Builds Chinese Wikipedia video game stubs, previews the article and related edits, and preserves recovery state throughout the workflow."
        ],
        "noticeFiles": [
            "LICENSE"
        ],
        "outputName": "vg_stub_creator",
        "defines": {
            "__VG_STUB_CREATOR_SHARED_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/shared.css"
            },
            "__VG_STUB_CREATOR_MAIN_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/main-dialog.vue"
            },
            "__VG_STUB_CREATOR_MAIN_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/main-dialog.css"
            },
            "__VG_STUB_CREATOR_PRE_SAVE_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/pre-save-dialog.vue"
            },
            "__VG_STUB_CREATOR_PRE_SAVE_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/pre-save-dialog.css"
            },
            "__VG_STUB_CREATOR_COMPANY_CATEGORY_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/company-category-dialog.vue"
            },
            "__VG_STUB_CREATOR_COMPANY_CATEGORY_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/company-category-dialog.css"
            },
            "__VG_STUB_CREATOR_CATEGORY_VIEW_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/category-view-dialog.vue"
            },
            "__VG_STUB_CREATOR_CATEGORY_VIEW_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/category-view-dialog.css"
            },
            "__VG_STUB_CREATOR_PAGE_EDIT_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/page-edit-dialog.vue"
            },
            "__VG_STUB_CREATOR_PAGE_EDIT_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/page-edit-dialog.css"
            },
            "__VG_STUB_CREATOR_MOVE_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/move-dialog.vue"
            },
            "__VG_STUB_CREATOR_MOVE_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/move-dialog.css"
            },
            "__VG_STUB_CREATOR_PREVIEW_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/preview-dialog.vue"
            },
            "__VG_STUB_CREATOR_PREVIEW_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/preview-dialog.css"
            },
            "__VG_STUB_CREATOR_HISTORY_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/history-dialog.vue"
            },
            "__VG_STUB_CREATOR_HISTORY_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/history-dialog.css"
            },
            "__VG_STUB_CREATOR_HISTORY_JSON_DIALOG_TEMPLATE__": {
                "textFile": "ui/dialogs/history-json-dialog.vue"
            },
            "__VG_STUB_CREATOR_HISTORY_JSON_DIALOG_STYLES__": {
                "textFile": "ui/dialogs/history-json-dialog.css"
            }
        },
        "userscript": {
            "name": "VG Stub Creator",
            "match": [
                "https://en.wikipedia.org/*",
                "https://zh.wikipedia.org/*"
            ]
        }
    },
    "files": [
        "README.md",
        "AGENTS.md",
        "CHANGELOG.md",
        "LICENSE",
        "docs",
        "*.ts",
        "workflows",
        "domain",
        "infra",
        "i18n",
        "ui",
        "support",
        "config"
    ],
    "keywords": [
        "mediawiki",
        "gadget",
        "wikipedia",
        "zhwiki",
        "video-games"
    ],
    "scripts": {
        "build": "node ../../scripts/gadget-build/cli.ts",
        "check": "npm run lint && tsc --noEmit -p ../../tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --test ../../tests/vg-stub-creator/*.test.ts",
        "prepublishOnly": "npm run check"
    },
    "engines": {
        "node": ">=22.18"
    },
    "devDependencies": {
        "@wikimedia/codex": "^2.6.0",
        "vue": "3.5.13"
    }
}
