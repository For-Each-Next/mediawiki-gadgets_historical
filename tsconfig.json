{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": false,
        "checkJs": false,
        "lib": ["DOM", "ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "types": ["node", "types-mediawiki"],
        "paths": {
            "#shared": ["./src/shared/index.ts"],
            "#shared/cite": ["./src/shared/cite/index.ts"],
            "#shared/edit-box": ["./src/shared/edit-box.ts"],
            "#shared/html": ["./src/shared/html.ts"],
            "#shared/i18n": ["./src/shared/i18n.ts"],
            "#shared/wikitext": ["./src/shared/wikitext.ts"]
        }
    },
    "include": [
        "*.config.ts",
        "scripts/**/*.ts",
        "src/**/*.ts",
        "tests/**/*.ts"
    ]
}
