{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": false,
        "checkJs": false,
        "lib": ["DOM", "ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "tsBuildInfoFile": "./node_modules/.cache/vue-tsc/root.tsbuildinfo",
        "types": ["types-mediawiki"],
        "verbatimModuleSyntax": true
    },
    "include": ["src/**/*.ts"],
    "references": [
        { "path": "./config/vue/tsconfig.citation-formatter.json" },
        { "path": "./config/vue/tsconfig.vg-page-assessor.json" },
        { "path": "./config/vue/tsconfig.vg-stub-creator.json" },
        { "path": "./config/vue/tsconfig.wiked-lite.json" }
    ]
}
