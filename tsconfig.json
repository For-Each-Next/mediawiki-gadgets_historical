{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": false,
        "checkJs": false,
        "lib": ["DOM", "ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": false,
        "target": "ES2024",
        "types": ["node", "types-mediawiki"]
    },
    "include": ["*.config.ts", "scripts/**/*.ts", "src/**/*.ts"],
    "exclude": ["tests"]
}
