{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "allowJs": false,
        "checkJs": false,
        "lib": ["DOM", "ES2024"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "tsBuildInfoFile": "./node_modules/.cache/vue-tsc/root.tsbuildinfo",
        "types": ["node", "types-mediawiki"],
        "paths": {
            "#shared": ["./src/shared/index.ts"],
            "#shared/citoid": ["./src/shared/citoid.ts"],
            "#shared/edit-box": ["./src/shared/edit-box.ts"],
            "#shared/html": ["./src/shared/html.ts"],
            "#shared/i18n": ["./src/shared/i18n.ts"],
            "#shared/language-code": ["./src/shared/language-code.ts"],
            "#shared/wikitext": ["./src/shared/wikitext.ts"]
        }
    },
    "include": [
        "*.config.ts",
        "scripts/**/*.ts",
        "src/**/*.ts",
        "tests/**/*.ts"
    ],
    "references": [
        { "path": "./config/vue/tsconfig.citation-formatter.json" },
        { "path": "./config/vue/tsconfig.vg-page-assessor.json" },
        { "path": "./config/vue/tsconfig.vg-stub-creator.json" }
    ]
}
